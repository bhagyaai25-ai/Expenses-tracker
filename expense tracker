expenses=[]
while True:
    print("____expense tracker____")
    print("1.add expense")
    print("2.view expense")
    print("3.total expense")
    print("4.exit")
    choice=int(input("enter your choice: "))
    if choice==1:
        item=input("enter your expense name: ")
        amount=int(input("enter the item amount: "))
        expenses.append([item,amount])
        print("expense added successfully")
    elif choice==2:
        if len(expenses)<=0:
            print("no expenses found")
        else:
            print("your expenses: ")
            for i in range(len(expenses)):
                print(i+1,".",expenses[i][0],"-",expenses[i][1])
    elif choice==3:
        total=0
        for expense in expenses:
            total+=expense[1]
        print("total expense: ",total)
    elif choice==4:
        print("program ended")
        break
    else:
        print("invalid input")